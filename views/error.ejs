<% 
  // Use main layout if user is authenticated, otherwise minimal inline layout
  if (typeof user !== 'undefined' && user) {
    layout('layouts/main');
  } else {
    layout('layouts/auth');
  }
%>

<div style="text-align: center; padding: 40px 0;">
  <div style="font-size: 64px; margin-bottom: 16px; opacity: 0.4;">⚠️</div>
  <h1 style="font-size: 24px; margin-bottom: 8px;">Something went wrong</h1>
  <p style="color: var(--text-muted); margin-bottom: 24px; max-width: 400px; margin-left: auto; margin-right: auto;">
    <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %>
  </p>
  <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
    <% if (typeof user !== 'undefined' && user) { %>
    <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
    <% } else { %>
    <a href="/" class="btn btn-primary">Go to Login</a>
    <% } %>
    <button onclick="history.back()" class="btn btn-ghost">Go Back</button>
  </div>
</div>
