<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% if (typeof csrfToken !== 'undefined') { %>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
  <title><%= typeof branding !== 'undefined' && branding.site_name ? branding.site_name : 'FreeNode' %> Dashboard</title>
  <% if (typeof branding !== 'undefined' && branding.favicon_url) { %>
  <link rel="icon" href="<%= branding.favicon_url %>">
  <% } %>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <% if (typeof branding !== 'undefined' && branding.bg_image_url) { %>
  <style>
    body { background-image: url('<%= branding.bg_image_url %>'); background-size: cover; background-attachment: fixed; background-position: center; }
    .app-layout { background: transparent; }
  </style>
  <% } %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <div class="app-layout" id="appLayout">
    <%- include('../partials/sidebar') %>
    <%- include('../partials/navbar') %>
    <main class="main-content">
      <!-- Top announcements -->
      <% if (typeof announcements !== 'undefined') { %>
        <% announcements.filter(function(a){ return a.position === 'top'; }).forEach(function(a) { %>
        <%- include('../partials/announcement', { a: a }) %>
        <% }); %>
      <% } %>
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
  </div>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <script src="/js/ui.js"></script>
  <script src="/js/sidebar.js"></script>
  <script>
    // Disable common inspect shortcuts for casual users
    document.addEventListener('keydown', function(e) {
      // Ctrl+U (view source), Ctrl+Shift+I/J/C (devtools), F12
      if (
        (e.ctrlKey && e.key === 'u') ||
        (e.ctrlKey && e.shiftKey && ['i','j','c'].includes(e.key.toLowerCase())) ||
        e.key === 'F12'
      ) {
        e.preventDefault();
        return false;
      }
    });
    // Disable right-click context menu
    document.addEventListener('contextmenu', function(e) {
      e.preventDefault();
      return false;
    });
  </script>
</body>
</html>
