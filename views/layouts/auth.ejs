<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof branding !== 'undefined' && branding.site_name ? branding.site_name : 'Razer' %> Dashboard</title>
  <% if (typeof branding !== 'undefined' && branding.favicon_url) { %>
  <link rel="icon" href="<%= branding.favicon_url %>">
  <% } %>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <% if (typeof branding !== 'undefined' && branding.bg_image_url) { %>
  <style>
    body { background-image: url('<%= branding.bg_image_url %>'); background-size: cover; background-attachment: fixed; background-position: center; }
    .auth-wrapper { background: transparent; }
    .auth-card { backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); background: rgba(19,22,30,0.85); }
  </style>
  <% } %>
</head>
<body>
  <div class="auth-wrapper">
    <div class="auth-card">
      <%- body %>
    </div>
  </div>
  <script>
    document.addEventListener('keydown', function(e) {
      if (
        (e.ctrlKey && e.key === 'u') ||
        (e.ctrlKey && e.shiftKey && ['i','j','c'].includes(e.key.toLowerCase())) ||
        e.key === 'F12'
      ) { e.preventDefault(); return false; }
    });
    document.addEventListener('contextmenu', function(e) { e.preventDefault(); return false; });
  </script>
</body>
</html>
