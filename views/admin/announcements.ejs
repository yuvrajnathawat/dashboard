<div class="page-header">
  <h1>Announcements</h1>
  <p>Add banners, video embeds, or promotions shown across the dashboard.</p>
</div>

<%- include('../partials/flash') %>

<!-- Add Form -->
<div class="card" style="margin-bottom:24px;">
  <div class="card-header"><h2 class="card-title">Add New Announcement</h2></div>
  <form method="POST" action="/admin/announcements/add">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="grid-2">
      <div class="form-group">
        <label class="form-label">Title</label>
        <input type="text" name="title" class="form-input" placeholder="e.g. Summer Sale!" required>
      </div>
      <div class="form-group">
        <label class="form-label">Type</label>
        <select name="type" class="form-select" id="typeSelect" onchange="toggleFields()">
          <option value="banner">📢 Banner (text + link)</option>
          <option value="video">🎬 Video (YouTube/embed)</option>
          <option value="promotion">🎁 Promotion (highlighted card)</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Position</label>
        <select name="position" class="form-select">
          <option value="top">Top of every page</option>
          <option value="dashboard">Dashboard page</option>
          <option value="sidebar">Below sidebar nav</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Sort Order (lower = first)</label>
        <input type="number" name="sort_order" class="form-input" value="0" min="0">
      </div>
    </div>

    <div class="form-group" id="contentField">
      <label class="form-label">Message / Description</label>
      <textarea name="content" class="form-input" rows="3" placeholder="Text shown to users..."></textarea>
    </div>

    <div class="form-group" id="embedField" style="display:none;">
      <label class="form-label">Video Embed URL</label>
      <input type="url" name="embed_url" class="form-input" placeholder="https://www.youtube.com/embed/VIDEO_ID">
      <div class="form-hint">Use the YouTube embed URL: youtube.com/embed/VIDEO_ID</div>
    </div>

    <div class="form-group" id="thumbnailField" style="display:none;">
      <label class="form-label">Custom Thumbnail Image URL</label>
      <input type="url" name="thumbnail_url" class="form-input" placeholder="https://example.com/thumbnail.jpg">
      <div class="form-hint">Shown as preview image. If empty, YouTube thumbnail is auto-fetched.</div>
    </div>

    <div class="grid-2">
      <div class="form-group">
        <label class="form-label">Button / Link URL (optional)</label>
        <input type="url" name="link_url" class="form-input" placeholder="https://...">
      </div>
      <div class="form-group">
        <label class="form-label">Button Text (optional)</label>
        <input type="text" name="link_text" class="form-input" placeholder="e.g. Learn More">
      </div>
    </div>

    <button type="submit" class="btn btn-primary">Add Announcement</button>
  </form>
</div>

<!-- List -->
<div class="card">
  <div class="card-header"><h2 class="card-title">All Announcements (<%= items.length %>)</h2></div>
  <% if (items.length === 0) { %>
  <div class="empty-state"><div class="empty-state-icon">📢</div><p>No announcements yet.</p></div>
  <% } else { %>
  <div style="overflow-x:auto;">
    <table class="table">
      <thead><tr><th>Title</th><th>Type</th><th>Position</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% items.forEach(function(item) { %>
        <tr>
          <td>
            <div style="font-weight:600;color:var(--text-primary)"><%= item.title %></div>
            <% if (item.content) { %><div style="font-size:12px;color:var(--text-muted);margin-top:2px;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= item.content %></div><% } %>
            <% if (item.embed_url) { %><div style="font-size:11px;color:var(--accent);margin-top:2px;">📹 <%= item.embed_url %></div><% } %>
          </td>
          <td>
            <span class="badge badge-<%= item.type === 'banner' ? 'active' : item.type === 'video' ? 'installing' : 'suspended' %>">
              <%= item.type %>
            </span>
          </td>
          <td style="color:var(--text-muted);font-size:13px;"><%= item.position %></td>
          <td><span class="badge badge-<%= item.is_active ? 'active' : 'suspended' %>"><%= item.is_active ? 'Active' : 'Inactive' %></span></td>
          <td style="display:flex;gap:8px;">
            <form method="POST" action="/admin/announcements/<%= item.id %>/toggle">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button class="btn btn-ghost btn-sm"><%= item.is_active ? 'Disable' : 'Enable' %></button>
            </form>
            <form method="POST" action="/admin/announcements/<%= item.id %>/delete" onsubmit="return UI && UI.confirm ? false : confirm('Delete?')">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button class="btn btn-sm" style="background:var(--danger);color:#fff;border:none;" type="submit">Delete</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<script>
function toggleFields() {
  var type = document.getElementById('typeSelect').value;
  document.getElementById('embedField').style.display = type === 'video' ? 'block' : 'none';
  document.getElementById('thumbnailField').style.display = type === 'video' ? 'block' : 'none';
  document.getElementById('contentField').style.display = type === 'video' ? 'none' : 'block';
}
</script>
