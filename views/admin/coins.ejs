<div class="page-header">
  <h1>Coin Management</h1>
  <p>Give, take, and broadcast coins to users.</p>
</div>

<div class="grid-2" style="margin-bottom: 24px;">
  <div class="card">
    <div class="card-header"><h2 class="card-title">Give / Take Coins</h2></div>
    <div class="form-group">
      <label class="form-label">User ID</label>
      <input type="number" id="g_userid" class="form-input" placeholder="User database ID" min="1">
    </div>
    <div class="form-group">
      <label class="form-label">Amount (positive = give, negative = take)</label>
      <input type="number" id="g_amount" class="form-input" placeholder="e.g. 100 or -50">
    </div>
    <div class="form-group">
      <label class="form-label">Reason</label>
      <input type="text" id="g_reason" class="form-input" value="Admin adjustment">
    </div>
    <button class="btn btn-primary" style="width:100%" onclick="giveCoins()">Apply</button>
    <div style="margin-top:10px;font-size:13px;text-align:center;min-height:20px" id="giveResult"></div>
  </div>

  <div class="card">
    <div class="card-header"><h2 class="card-title">Broadcast to All Users</h2></div>
    <div class="form-group">
      <label class="form-label">Amount per user</label>
      <input type="number" id="bc_amount" class="form-input" placeholder="10" min="1">
    </div>
    <div class="form-group">
      <label class="form-label">Reason</label>
      <input type="text" id="bc_reason" class="form-input" value="Admin broadcast">
    </div>
    <div class="alert alert-warning" style="margin-bottom:16px;font-size:12px">⚠️ This credits ALL users. Use with caution.</div>
    <button class="btn btn-warning" style="width:100%" onclick="broadcastCoins()">Broadcast</button>
    <div style="margin-top:10px;font-size:13px;text-align:center;min-height:20px" id="broadcastResult"></div>
  </div>
</div>

<div class="card-header" style="margin-bottom:12px"><h2 style="font-size:18px;font-weight:600">Transaction Log</h2></div>
<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr><th>Actor</th><th>Recipient</th><th>Amount</th><th>Reason</th><th>Date</th></tr>
    </thead>
    <tbody>
      <% if (typeof transactions !== 'undefined' && transactions && transactions.length > 0) { %>
        <% transactions.forEach(function(tx) { %>
        <tr>
          <td style="color:var(--text-muted);font-size:12px"><%= tx.actor_username || 'System' %></td>
          <td style="font-weight:500"><%= tx.recipient_username %></td>
          <td style="font-weight:700;color:<%= tx.amount >= 0 ? 'var(--success)' : 'var(--danger)' %>">
            <%= tx.amount >= 0 ? '+' : '' %><%= tx.amount.toLocaleString() %>
          </td>
          <td style="color:var(--text-muted);font-size:12px"><%= tx.reason %></td>
          <td style="color:var(--text-muted);font-size:12px"><%= new Date(tx.created_at).toLocaleString() %></td>
        </tr>
        <% }); %>
      <% } else { %>
      <tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:40px">No transactions yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
<div class="pagination">
  <% for (var i = 1; i <= totalPages; i++) { %>
    <% if (i === page) { %><span class="current"><%= i %></span>
    <% } else { %><a href="/admin/coins?page=<%= i %>"><%= i %></a><% } %>
  <% } %>
</div>
<% } %>

<script>
function showMsg(id, ok, msg) {
  var el = document.getElementById(id);
  if (!el) return;
  el.style.color = ok ? 'var(--success)' : 'var(--danger)';
  el.textContent = msg;
}

function apiPost(url, data, cb) {
  fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'same-origin',
    body: JSON.stringify(data)
  })
  .then(function(r) { return r.json(); })
  .then(cb)
  .catch(function(e) { cb({ error: e.message }); });
}

function giveCoins() {
  var uid = parseInt(document.getElementById('g_userid').value);
  var amt = parseInt(document.getElementById('g_amount').value);
  var reason = document.getElementById('g_reason').value || 'Admin adjustment';
  if (!uid || isNaN(uid)) { showMsg('giveResult', false, 'Enter a valid User ID.'); return; }
  if (!amt || isNaN(amt) || amt === 0) { showMsg('giveResult', false, 'Enter a valid amount.'); return; }
  showMsg('giveResult', true, 'Sending...');
  apiPost('/admin/coins/give', { user_id: uid, amount: amt, reason: reason }, function(res) {
    if (res.success) { showMsg('giveResult', true, '✓ Done! New balance: ' + res.newBalance.toLocaleString()); setTimeout(function(){ location.reload(); }, 1500); }
    else showMsg('giveResult', false, res.error || 'Failed.');
  });
}

function broadcastCoins() {
  var amt = parseInt(document.getElementById('bc_amount').value);
  var reason = document.getElementById('bc_reason').value || 'Admin broadcast';
  if (!amt || amt < 1) { showMsg('broadcastResult', false, 'Enter a valid amount.'); return; }
  if (!confirm('Broadcast ' + amt + ' coins to ALL users?')) return;
  showMsg('broadcastResult', true, 'Broadcasting...');
  apiPost('/admin/coins/broadcast', { amount: amt, reason: reason }, function(res) {
    if (res.success) { showMsg('broadcastResult', true, '✓ Credited ' + res.count + ' users!'); setTimeout(function(){ location.reload(); }, 1500); }
    else showMsg('broadcastResult', false, res.error || 'Failed.');
  });
}
</script>
