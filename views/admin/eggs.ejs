<div class="page-header">
  <h1>Egg Configuration</h1>
  <p>Enable or disable server types available to users.</p>
</div>

<% if (typeof nests !== 'undefined' && nests && nests.length > 0) { %>
  <% nests.forEach(function(nest) { %>
  <div class="card" style="margin-bottom:20px">
    <div class="card-header">
      <h2 class="card-title"><%= nest.attributes.name %> <span style="font-size:12px;color:var(--text-muted);font-weight:400;margin-left:8px"><%= nest.attributes.description || '' %></span></h2>
    </div>
    <% if (nest.eggs && nest.eggs.length > 0) { %>
    <div style="display:flex;flex-direction:column;gap:10px">
      <% nest.eggs.forEach(function(egg) { %>
      <% var eggId = egg.attributes.id; var isEnabled = typeof enabledEggIds !== 'undefined' && enabledEggIds.includes(eggId); %>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 16px;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:var(--radius-sm);flex-wrap:wrap">
        <div>
          <div style="font-weight:600;margin-bottom:2px"><%= egg.attributes.name %></div>
          <div style="font-size:12px;color:var(--text-muted)">ID: <%= eggId %></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          <% if (isEnabled) { %>
          <span class="badge badge-active">Enabled</span>
          <button class="btn btn-danger btn-sm" onclick="toggleEgg(<%= eggId %>, 'disable')">Disable</button>
          <% } else { %>
          <span class="badge badge-suspended">Disabled</span>
          <button class="btn btn-success btn-sm" onclick="toggleEgg(<%= eggId %>, 'enable')">Enable</button>
          <% } %>
          <button class="btn btn-ghost btn-sm" onclick="openDefaults(<%= eggId %>, '<%= egg.attributes.name.replace(/'/g, "\\'") %>')">Set Defaults</button>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <p style="color:var(--text-muted);font-size:13px">No eggs in this nest.</p>
    <% } %>
  </div>
  <% }); %>
<% } else { %>
<div class="card">
  <div class="empty-state">
    <div class="empty-state-icon">🥚</div>
    <h3>No eggs found</h3>
    <p>Could not fetch eggs from Pterodactyl. Check your API configuration.</p>
  </div>
</div>
<% } %>

<div class="modal-overlay" id="defaultsModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title">Set Defaults — <span id="defaultsEggName"></span></h3>
      <button class="modal-close" onclick="document.getElementById('defaultsModal').classList.remove('active')">&times;</button>
    </div>
    <div class="form-group">
      <label class="form-label">RAM (MB)</label>
      <input type="number" id="d_ram" class="form-input" placeholder="1024" min="128">
    </div>
    <div class="form-group">
      <label class="form-label">CPU (%)</label>
      <input type="number" id="d_cpu" class="form-input" placeholder="100" min="10">
    </div>
    <div class="form-group">
      <label class="form-label">Disk (MB)</label>
      <input type="number" id="d_disk" class="form-input" placeholder="5120" min="512">
    </div>
    <button class="btn btn-primary" style="width:100%" onclick="submitDefaults()">Save Defaults</button>
    <div style="margin-top:12px;font-size:13px;text-align:center;min-height:20px" id="defaultsResult"></div>
  </div>
</div>

<script>
var currentEggId = null;

function apiPost(url, data, cb) {
  fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'same-origin',
    body: JSON.stringify(data)
  })
  .then(function(r) { return r.json(); })
  .then(cb)
  .catch(function(e) { cb({ error: e.message }); });
}

function toggleEgg(eggId, action) {
  apiPost('/admin/eggs/' + eggId + '/' + action, {}, function(data) {
    if (data.success) location.reload();
    else alert(data.error || 'Failed.');
  });
}

function openDefaults(eggId, eggName) {
  currentEggId = eggId;
  document.getElementById('defaultsEggName').textContent = eggName;
  document.getElementById('defaultsResult').textContent = '';
  document.getElementById('defaultsModal').classList.add('active');
}

function submitDefaults() {
  var ram = parseInt(document.getElementById('d_ram').value);
  var cpu = parseInt(document.getElementById('d_cpu').value);
  var disk = parseInt(document.getElementById('d_disk').value);
  if (!ram || !cpu || !disk) { alert('Fill in all fields.'); return; }
  apiPost('/admin/eggs/' + currentEggId + '/defaults', { ram_mb: ram, cpu_percent: cpu, disk_mb: disk }, function(data) {
    var el = document.getElementById('defaultsResult');
    if (data.success) {
      el.style.color = 'var(--success)'; el.textContent = '✓ Defaults saved.';
      setTimeout(function() { document.getElementById('defaultsModal').classList.remove('active'); }, 1000);
    } else { el.style.color = 'var(--danger)'; el.textContent = data.error || 'Failed.'; }
  });
}

document.getElementById('defaultsModal').addEventListener('click', function(e) {
  if (e.target === this) this.classList.remove('active');
});
</script>
