<% if (a.type === 'banner' || a.type === 'promotion') { %>
<div style="
  margin-bottom: 16px;
  border-radius: var(--radius);
  padding: 14px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
  background: <%= a.type === 'promotion'
    ? 'linear-gradient(135deg, rgba(88,101,242,0.18) 0%, rgba(139,92,246,0.12) 100%)'
    : 'rgba(254,231,92,0.08)' %>;
  border: 1px solid <%= a.type === 'promotion' ? 'rgba(88,101,242,0.25)' : 'rgba(254,231,92,0.2)' %>;
  animation: fadeSlideIn 0.4s ease;
">
  <div style="flex:1;min-width:0;">
    <div style="font-weight:700;font-size:14px;color:var(--text-primary);margin-bottom:2px;"><%= a.title %></div>
    <% if (a.content) { %><div style="font-size:13px;color:var(--text-muted);"><%= a.content %></div><% } %>
  </div>
  <% if (a.link_url) { %>
  <a href="<%= a.link_url %>" target="_blank" rel="noopener noreferrer"
     style="flex-shrink:0;padding:7px 16px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;
            background:<%= a.type === 'promotion' ? 'var(--accent)' : 'var(--warning)' %>;
            color:<%= a.type === 'promotion' ? '#fff' : '#0d0f14' %>;">
    <%= a.link_text || 'Learn More' %>
  </a>
  <% } %>
</div>

<% } else if (a.type === 'video' && a.embed_url) { %>
<%
  var embedSrc = a.embed_url || '';
  // Extract video ID from any YouTube URL format
  var ytId = '';
  var ytMatch = embedSrc.match(/(?:embed\/|v=|youtu\.be\/|shorts\/)([a-zA-Z0-9_-]{11})/);
  if (ytMatch) ytId = ytMatch[1];

  // Use youtube-nocookie.com — bypasses many embedding restrictions
  var autoSrc = ytId
    ? 'https://www.youtube-nocookie.com/embed/' + ytId + '?autoplay=1&mute=1&loop=1&playlist=' + ytId + '&rel=0&modestbranding=1&iv_load_policy=3&controls=1'
    : embedSrc + (embedSrc.indexOf('?') !== -1 ? '&' : '?') + 'autoplay=1&mute=1';

  var vidHeight = (a.video_height && a.video_height > 0) ? a.video_height : 360;
%>
<div style="margin-bottom:20px;border-radius:var(--radius);overflow:hidden;border:1px solid var(--border);background:var(--bg-card);animation:fadeSlideIn 0.4s ease;<%= (a.video_max_width && a.video_max_width > 0) ? 'max-width:' + a.video_max_width + 'px;' : '' %>">
  <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
    <div>
      <span style="font-weight:600;font-size:14px;color:var(--text-primary);">🎬 <%= a.title %></span>
      <% if (a.content) { %><span style="font-size:13px;color:var(--text-muted);margin-left:8px;"><%= a.content %></span><% } %>
    </div>
    <% if (a.link_url) { %>
    <a href="<%= a.link_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm"><%= a.link_text || 'Watch' %></a>
    <% } else if (ytId) { %>
    <a href="https://www.youtube.com/watch?v=<%= ytId %>" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">Watch on YouTube</a>
    <% } %>
  </div>
  <div style="position:relative;height:<%= vidHeight %>px;overflow:hidden;background:#000;">
    <iframe
      src="<%= autoSrc %>"
      style="position:absolute;top:0;left:0;width:100%;height:100%;border:none;"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</div>
<% } %>

<style>
@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}
</style>
