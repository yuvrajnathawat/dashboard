<% layout('layouts/main') %>
<% bodyClass = 'page-earn' %>

<div class="page-header">
  <h1>Earn Coins</h1>
  <p>Complete tasks and offers to earn coins instantly.</p>
</div>

<% if (!links || links.length === 0) { %>
<div class="card">
  <div class="empty-state">
    <div class="empty-state-icon">💰</div>
    <h3>No earn links available</h3>
    <p>Check back later — the admin will add earn opportunities soon.</p>
  </div>
</div>
<% } else { %>
<div class="earn-grid">
  <% links.forEach(function(link) { %>
  <%
    var isAvailable = !link.cooldownRemainingSeconds || link.cooldownRemainingSeconds <= 0;
    var cooldownHours = link.cooldownRemainingSeconds ? Math.ceil(link.cooldownRemainingSeconds / 3600) : 0;
  %>
  <div class="earn-card">
    <div class="earn-card-title"><%= link.name %></div>

    <div class="earn-card-reward">
      <svg class="coin-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="width:22px;height:22px;">
        <circle cx="12" cy="12" r="10" fill="currentColor" opacity="0.2"/>
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <text x="12" y="16" text-anchor="middle" font-size="10" fill="currentColor" font-weight="bold">$</text>
      </svg>
      <%= link.coin_reward %> coins
    </div>

    <div class="earn-card-cooldown">
      <% if (isAvailable) { %>
        <span style="color: var(--success);">✓ Available now</span>
      <% } else { %>
        <span style="color: var(--warning);">⏱ Available in ~<%= cooldownHours %>h</span>
      <% } %>
    </div>

    <button
      class="btn btn-success btn-sm earn-btn"
      data-link-id="<%= link.id %>"
      data-link-url="<%= link.url %>"
      data-reward="<%= link.coin_reward %>"
      <% if (!isAvailable) { %>disabled<% } %>
    >
      <% if (isAvailable) { %>
        Earn Now →
      <% } else { %>
        On Cooldown
      <% } %>
    </button>
  </div>
  <% }); %>
</div>
<% } %>

<!-- Verification Modal -->
<div class="modal-overlay" id="verifyModal">
  <div class="modal">
    <div class="modal-header">
      <h3 class="modal-title">Verify Completion</h3>
      <button class="modal-close" id="closeModal">&times;</button>
    </div>
    <p style="margin-bottom: 20px; font-size: 14px;">
      Complete the offer in the new tab, then click verify below.
    </p>
    <div id="verifyTimer" style="text-align: center; font-size: 32px; font-weight: 700; color: var(--accent); font-family: var(--font-primary); margin-bottom: 20px;">30</div>
    <p style="font-size: 12px; color: var(--text-muted); text-align: center; margin-bottom: 20px;">
      Please wait before verifying
    </p>
    <button class="btn btn-success" id="verifyBtn" style="width: 100%;" disabled>
      Verify Completion
    </button>
    <div id="verifyResult" style="margin-top: 12px; text-align: center; font-size: 14px;"></div>
  </div>
</div>

<script>
(function() {
  var currentLinkId = null;
  var timerInterval = null;
  var csrfToken = document.querySelector('meta[name="csrf-token"]') ? document.querySelector('meta[name="csrf-token"]').content : '';

  function openModal(linkId) {
    currentLinkId = linkId;
    var modal = document.getElementById('verifyModal');
    var verifyBtn = document.getElementById('verifyBtn');
    var timerEl = document.getElementById('verifyTimer');
    var resultEl = document.getElementById('verifyResult');

    modal.classList.add('active');
    verifyBtn.disabled = true;
    resultEl.textContent = '';

    var seconds = 30;
    timerEl.textContent = seconds;

    timerInterval = setInterval(function() {
      seconds--;
      timerEl.textContent = seconds;
      if (seconds <= 0) {
        clearInterval(timerInterval);
        timerEl.textContent = '✓';
        timerEl.style.color = 'var(--success)';
        verifyBtn.disabled = false;
        document.querySelector('.modal p:nth-child(3)').textContent = 'You can now verify your completion.';
      }
    }, 1000);
  }

  function closeModal() {
    document.getElementById('verifyModal').classList.remove('active');
    if (timerInterval) clearInterval(timerInterval);
    currentLinkId = null;
  }

  // Earn button click
  document.querySelectorAll('.earn-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var linkId = this.dataset.linkId;
      var linkUrl = this.dataset.linkUrl;

      fetch('/earn/' + linkId + '/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
        credentials: 'same-origin'
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.error) {
          alert(data.error);
          return;
        }
        window.open(linkUrl, '_blank', 'noopener,noreferrer');
        openModal(linkId);
      })
      .catch(function() { alert('Failed to start earn. Please try again.'); });
    });
  });

  // Verify button
  document.getElementById('verifyBtn').addEventListener('click', function() {
    if (!currentLinkId) return;
    var btn = this;
    btn.disabled = true;
    btn.textContent = 'Verifying...';

    fetch('/earn/' + currentLinkId + '/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'CSRF-Token': csrfToken },
      credentials: 'same-origin'
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var resultEl = document.getElementById('verifyResult');
      if (data.balance !== undefined) {
        resultEl.style.color = 'var(--success)';
        resultEl.textContent = '✓ Coins credited! New balance: ' + data.balance.toLocaleString();
        setTimeout(function() { closeModal(); location.reload(); }, 1500);
      } else {
        resultEl.style.color = 'var(--danger)';
        resultEl.textContent = data.error || 'Verification failed.';
        btn.disabled = false;
        btn.textContent = 'Verify Completion';
      }
    })
    .catch(function() {
      document.getElementById('verifyResult').textContent = 'Network error.';
      btn.disabled = false;
      btn.textContent = 'Verify Completion';
    });
  });

  document.getElementById('closeModal').addEventListener('click', closeModal);
  document.getElementById('verifyModal').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
  });
})();
</script>
